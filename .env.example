# Copy to .env and fill in. .env is gitignored.

# Telegram bot token from @BotFather
BOT_TOKEN=

# Comma-separated Telegram user IDs with admin rights
ADMIN_USER_IDS=

# Public demo channel: mirror Discovery deals here in real time.
# Numeric channel id (preferred, e.g. -1001234567890) or @username.
# The bot must be an admin of the channel with the "Post messages" right.
# Requires at least one Discovery user enabled (you) to trigger scanning.
# Leave empty to disable.
# DEMO_CHANNEL_ID=

# Optional overrides
# DB_PATH=data/techhunter.db
# DEFAULT_CITY_SLUG=rossiya
# TELEGRAM_PROXY=http://127.0.0.1:1080  # socks5://... or http://...

# Recycle Chrome on this interval (seconds) to flush memory / reset throttling
# on long runs. Lower it if RAM-tight or throttled sooner, 0 to disable.
# Session survives the restart.
# BROWSER_RESTART_INTERVAL_SEC=600

# Newest listings window scanned on every fast cycle. Keep this small: 2-3 pages
# catches high-volume moments without turning the fast loop into a slow crawl.
# FAST_SCAN_PAGES=3

# Discovery Mode (broad category scan).
# Baselines are learned cheaply from search cards; a listing is only opened
# when it already looks like a deal. DEEP_PER_CYCLE caps those detail opens.
# MIN_PRICE is the junk floor (drops "старое говно"); no-name brands are
# already excluded by the model normalizer.
# DISCOVERY_MIN_PRICE=5000
# DISCOVERY_DEEP_PER_CYCLE=15
# DISCOVERY_MIN_PROFIT_RUB=7000
# DISCOVERY_MIN_PROFIT_RATIO=0.20
# DISCOVERY_MIN_ROI_RATIO=0.20
# DISCOVERY_MIN_DEAL_SCORE=65

# Conservative flip economics
# PROFIT_OVERHEAD_RUB=1000
# PROFIT_HAGGLE_PERCENT=0.05
# PROFIT_SAFETY_BUFFER_HIGH=0.03
# PROFIT_SAFETY_BUFFER_MEDIUM=0.06
# PROFIT_SAFETY_BUFFER_LOW=0.10
# REPAIR_ESTIMATE_BUFFER_RATIO=0.20
# MIN_ROI_RATIO=0.12
# MIN_DEAL_SCORE=50
# REPOST_MIN_PRICE_DROP_RUB=1000
# REPOST_MIN_PRICE_DROP_RATIO=0.03

# Market learning
# BASELINE_LOOKBACK_DAYS=60
# BASELINE_IDENTICAL_PRICE_CAP=3

# Careful Discovery profile: one newest-page scan every 3-5 minutes, no deep
# page crawl, at most 3 detail opens with a pause between them.
# DISCOVERY_CAREFUL_INTERVAL_MIN_SEC=180
# DISCOVERY_CAREFUL_INTERVAL_MAX_SEC=300
# DISCOVERY_CAREFUL_PAGES=1
# DISCOVERY_CAREFUL_DEEP_PER_CYCLE=3
# DISCOVERY_CAREFUL_DETAIL_DELAY_MIN_SEC=4
# DISCOVERY_CAREFUL_DETAIL_DELAY_MAX_SEC=9
